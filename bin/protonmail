#!/usr/bin/env bun
/**
 * ProtonMail CLI for OpenClaw
 *
 * Runs the TypeScript sources directly — Bun needs no build step, so there is
 * no compiled copy to fall out of date with src/.
 *
 * Usage:
 *   protonmail list-inbox [--limit=10] [--unread]
 *   protonmail search <query> [--limit=10]
 *   protonmail read <message-id> [--attachment=<filename>]
 *   protonmail send --to=<email> --subject=<subject> --body=<body> [--cc=<email>] [--bcc=<email>] [--attach=<path> ...]
 *   protonmail reply <message-id> --body=<body> [--attach=<path> ...]
 *   protonmail list-folders [--kind=folder|label|system|all]
 *   protonmail create-folder <name> [--label]
 *   protonmail delete-folder <name> [--label]
 */

const { ProtonMailSkill, resolveAttachments, pickAttachment } = require('../src/index.ts');

const COMMANDS = [
  'Commands:',
  '  list-inbox [--limit=N] [--unread]',
  '  search <query> [--limit=N]',
  '  read <uid> [--attachment=<filename>]',
  '  send --to= --subject= --body= [--cc=] [--bcc=] [--attach=<path> ...]',
  '  reply <uid> --body= [--attach=<path> ...]',
  '  list-folders [--kind=folder|label|system|all]',
  '  create-folder <name> [--label]',
  '  delete-folder <name> [--label]',
].join('\n');

// Proton keeps folders and labels in separate trees and they behave
// differently, so the command says which it means rather than guessing.
function mailboxKind(args) {
  return args.includes('--label') ? 'label' : 'folder';
}

async function main() {
  const args = process.argv.slice(2);
  const command = args[0];

  if (!command) {
    console.error('Usage: protonmail <command> [options]');
    console.error(COMMANDS);
    process.exit(1);
  }

  // Resolved before any connection is opened, so a mistyped path fails on its
  // own message rather than after a session has been established.
  let attachments;
  try {
    attachments = resolveAttachments(getArgs(args, 'attach'));
  } catch (err) {
    console.error(`Error: ${err.message}`);
    process.exit(1);
  }

  const skill = new ProtonMailSkill();
  await skill.initialize();

  try {
    switch (command) {
      case 'list-inbox': {
        const limit = parseInt(getArg(args, 'limit') || '10');
        const unreadOnly = args.includes('--unread');
        const emails = await skill.listInbox(limit, unreadOnly);
        console.log(JSON.stringify(emails, null, 2));
        break;
      }

      case 'search': {
        const query = args[1];
        if (!query) {
          console.error('Error: search requires a query');
          process.exit(1);
        }
        const limit = parseInt(getArg(args, 'limit') || '10');
        const results = await skill.searchEmails(query, limit);
        console.log(JSON.stringify(results, null, 2));
        break;
      }

      case 'read': {
        const messageId = args[1];
        if (!messageId) {
          console.error('Error: read requires a message ID');
          process.exit(1);
        }
        const email = await skill.readEmail(messageId);

        const wanted = getArg(args, 'attachment');
        if (wanted) {
          // Raw bytes on stdout, so the caller redirects them to a file.
          const hit = pickAttachment(email.attachments || [], wanted);
          process.stdout.write(hit.content);
          break;
        }

        console.log(JSON.stringify({
          from: email.from?.text,
          to: email.to?.text,
          subject: email.subject,
          date: email.date,
          text: email.text,
          html: email.html,
          attachments: email.attachments?.map(a => ({
            filename: a.filename,
            contentType: a.contentType,
            size: a.size
          }))
        }, null, 2));
        break;
      }

      case 'send': {
        const to = getArg(args, 'to');
        const subject = getArg(args, 'subject');
        const body = getArg(args, 'body');
        const cc = getArg(args, 'cc');
        const bcc = getArg(args, 'bcc');

        if (!to || !subject || !body) {
          console.error('Error: send requires --to, --subject, and --body');
          process.exit(1);
        }

        const result = await skill.sendEmail(to, subject, body, { cc, bcc, attachments });
        console.log(JSON.stringify(result, null, 2));
        break;
      }

      case 'reply': {
        const messageId = args[1];
        const body = getArg(args, 'body');

        if (!messageId || !body) {
          console.error('Error: reply requires <message-id> and --body');
          process.exit(1);
        }

        const result = await skill.replyToEmail(messageId, body, { attachments });
        console.log(JSON.stringify(result, null, 2));
        break;
      }

      case 'list-folders': {
        const kind = getArg(args, 'kind') || 'all';
        if (!['all', 'folder', 'label', 'system', 'container'].includes(kind)) {
          console.error(`Error: --kind must be one of all, folder, label, system, container`);
          process.exit(1);
        }

        const boxes = await skill.listMailboxes();
        const shown = kind === 'all' ? boxes : boxes.filter(b => b.kind === kind);
        console.log(JSON.stringify(shown, null, 2));
        break;
      }

      case 'create-folder': {
        const name = args[1];
        if (!name) {
          console.error('Error: create-folder requires a name');
          console.error('Creates a folder; pass --label to create a label instead.');
          process.exit(1);
        }

        const result = await skill.createMailbox(name, mailboxKind(args));
        console.log(JSON.stringify(result, null, 2));
        break;
      }

      case 'delete-folder': {
        const name = args[1];
        if (!name) {
          console.error('Error: delete-folder requires a name');
          console.error('Deletes a folder; pass --label to delete a label instead.');
          process.exit(1);
        }

        const result = await skill.deleteMailbox(name, mailboxKind(args));
        console.log(JSON.stringify(result, null, 2));
        break;
      }

      default:
        console.error(`Unknown command: ${command}`);
        console.error(COMMANDS);
        process.exit(1);
    }

    await skill.cleanup();
  } catch (err) {
    console.error('Error:', err.message);
    await skill.cleanup();
    process.exit(1);
  }
}

function getArg(args, name) {
  const prefix = `--${name}=`;
  const arg = args.find(a => a.startsWith(prefix));
  return arg ? arg.substring(prefix.length) : null;
}

function getArgs(args, name) {
  const prefix = `--${name}=`;
  return args
    .filter(a => a.startsWith(prefix))
    .map(a => a.substring(prefix.length))
    .filter(Boolean);
}

main();
