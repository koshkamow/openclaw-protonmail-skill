#!/usr/bin/env bun
// The protonmail executable. An ES module that imports the CLI from src/ and
// turns its exit code into the process's own.
//
// The command itself lives in src/cli.ts: this file has no extension, and both
// tsc and Biome decide what to parse from the extension, so anything written
// here would be neither typechecked nor linted. Keeping it to an import means
// every line of the CLI is.
import { run } from '../src/cli';

process.exit(await run(process.argv.slice(2)));
